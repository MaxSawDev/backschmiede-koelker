# .env.prod.example
NODE_ENV=production
POSTGRES_PASSWORD=password
POSTGRES_DB=db
POSTGRES_USER=user

GOOGLE_MAPS_API_KEY=key
PLACES_METTINGEN_PLACE_ID=places/id
PLACES_RECKE_PLACE_ID=places/id

GOOGLE_BUSINESS_SYNC_ENABLED=0
GOOGLE_BUSINESS_SYNC_VALIDATE_ONLY=0
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_BUSINESS_ACCOUNT_ID=
GOOGLE_BUSINESS_LOCATION_ID_RECKE=
GOOGLE_BUSINESS_LOCATION_ID_METTINGEN=

HOSTNAME=0.0.0.0
PORT=3000

AUTH_URL=url
AUTH_TRUST_HOST=true
AUTH_SECRET=secret

ANALYTICS_SECRET=salt_for_hash
ANALYTICS_PREFIX=analytics:backschmiede:
REDIS_URL=redis://:REDIS_PASSWORD@redis:6379/0

# --- Explicit one-time admin seeding; never runs automatically in production ---
ADMIN_SEED_MODE=off
ADMIN_USERNAME=
ADMIN_PASSWORD=

DATABASE_URL=url
UPLOAD_DIR=/uploads

NEXT_PUBLIC_BASE_ASSET_URL=domain.de
NEXT_PUBLIC_BASE_URL=url

NEXT_PUBLIC_BUILDING=true
NEXT_PUBLIC_SHOW_PRODUCT_IMAGE_MIGRATION_BUTTON=false
